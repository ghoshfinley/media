<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.finley.media-backup-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/finley/Src/media/scripts/pull-backup.sh</string>
    </array>
    <!-- Runs daily at 12:30; if the Mac was asleep, launchd runs it on next wake -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Log must live OUTSIDE ~/media-backups, which is a --delete mirror of the Drobo -->
    <key>StandardOutPath</key>
    <string>/Users/finley/Library/Logs/media-backup-pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/finley/Library/Logs/media-backup-pull.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
