# User and group IDs for file ownership inside containers
# Run `id` in your terminal — use the uid and gid values
PUID=1000
PGID=1000

# Timezone
TZ=Australia/Sydney

# --- ProtonVPN / OpenVPN ---
# Go to proton.me/vpn → Downloads → OpenVPN configuration
# Your OpenVPN credentials are separate from your Proton account login.
# Find them at: proton.me/vpn → Account → OpenVPN / IKEv2 username

# OpenVPN username (shown on the Account page above)
OPENVPN_USER=your_openvpn_username_here

# OpenVPN password (shown on the Account page above)
OPENVPN_PASSWORD=your_openvpn_password_here

# Country for server selection — must match a ProtonVPN server country name
# Options: Netherlands, Switzerland, United States, United Kingdom, Germany,
#          France, Sweden, Canada, Australia, Japan, Singapore, Norway, Denmark
VPN_SERVER_COUNTRIES=Netherlands
