# User and group IDs for file ownership inside containers
# Run `id` in your terminal — use the uid and gid values
PUID=1000
PGID=1000

# Timezone
TZ=Australia/Sydney

# --- ProtonVPN / OpenVPN ---
# Go to proton.me/vpn → Downloads → OpenVPN configuration
# Your OpenVPN credentials are separate from your Proton account login.
# Find them at: proton.me/vpn → Account → OpenVPN / IKEv2 username

# OpenVPN username (shown on the Account page above)
OPENVPN_USER=your_openvpn_username_here

# OpenVPN password (shown on the Account page above)
OPENVPN_PASSWORD=your_openvpn_password_here

# Proton account login — used to refresh the VPN server list automatically every 24h
# This is your proton.me email and password, NOT the OpenVPN credentials above
PROTON_EMAIL=your_proton_email_here
PROTON_PASSWORD=your_proton_password_here

# Country for server selection — must match a ProtonVPN server country name
# Options: Netherlands, Switzerland, United States, United Kingdom, Germany,
#          France, Sweden, Canada, Australia, Japan, Singapore, Norway, Denmark
VPN_SERVER_COUNTRIES=Netherlands

# --- Homepage dashboard API keys ---
# Jellyfin: Admin Dashboard → API Keys → +
JELLYFIN_API_KEY=your_jellyfin_api_key_here
# Seerr: Settings → General → API Key
SEERR_API_KEY=your_seerr_api_key_here
# qBittorrent: the password you set in WebUI settings
QBITTORRENT_PASSWORD=your_qbittorrent_password_here
# Sonarr/Radarr/Prowlarr: Settings → General → Security → API Key
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
